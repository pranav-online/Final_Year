# Google Gemini API Key for AI Crop & Disease Advisory Reports
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenWeatherMap API Key (Free key from https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key

# MongoDB Database (Optional - falls back to local JSON store if offline)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=alip_local

# ─── Mandi price data (broker Demand Analysis) ───
# Personal key from data.gov.in (My Account). Without it the public sample key is
# used, which caps every page at 10 rows (~530 requests per daily pull).
DATA_GOV_API_KEY=
# Optional: CEDA (Ashoka University) key for the one-time history backfill.
CEDA_API_KEY=
# auto = MongoDB if reachable, else backend/data/mandi.sqlite3 ; or force mongo / sqlite
MANDI_STORE=auto
# Comma-separated subset of: tomato,banana,onion,potato,maize,paddy,rice,wheat,cotton,groundnut
MANDI_COMMODITIES=
# Run the daily ingestion scheduler in this process (set 0 on extra workers)
SCHEDULER_ENABLED=1
